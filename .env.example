# Copy to .env and edit.

# Google OAuth web client (see README). Redirect URI: PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://planner.fieldforge.dev
# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
# Signs sessions and encrypts Google refresh tokens. Generate: openssl rand -hex 32
SESSION_SECRET=

# Where to listen on the host. 127.0.0.1 = only via a reverse proxy on this machine.
BIND_ADDR=127.0.0.1
PORT=3100

# Set both to true when running behind an HTTPS reverse proxy.
TRUST_PROXY=true
COOKIE_SECURE=true
